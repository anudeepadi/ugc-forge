# Frontend Environment Variables

# API URL - Backend FastAPI endpoint (optional, defaults to localhost)
# For production, set this to your deployed backend URL
# Leave empty or set VITE_DEMO_MODE=true to run in demo mode without a backend
VITE_API_URL=http://localhost:8000/api/v1

# Demo Mode - When true, uses mock data instead of real API
# Set to "true" for frontend-only deployments without a backend
VITE_DEMO_MODE=false
