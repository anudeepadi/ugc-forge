# Database
DATABASE_URL=postgresql+asyncpg://ugcforge:ugcforge@db:5432/ugcforge

# Redis
REDIS_URL=redis://redis:6379/0

# Storage: "local" or "r2"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/renders

# Provider selection (stub = no API key needed)
SCRIPT_PROVIDER=stub
TTS_PROVIDER=stub
AVATAR_PROVIDER=stub

# Anthropic (set SCRIPT_PROVIDER=anthropic to activate)
ANTHROPIC_API_KEY=

# ElevenLabs (set TTS_PROVIDER=elevenlabs to activate)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# HeyGen (set AVATAR_PROVIDER=heygen to activate)
HEYGEN_API_KEY=

# Cloudflare R2 (set STORAGE_BACKEND=r2 to activate)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ugcforge-renders
R2_PUBLIC_URL=

# Meta Ads (Plan C)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
